<?xml version="1.0" encoding="utf-8"?>
<!-- The catalogue sites, their file hosts and some image hosts still answer
     or redirect over plain http; the Deck plugin fetched those too. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
